#pragma once

// Copy this file to secrets.h and fill in real values.
// secrets.h is gitignored.

#define WIFI_SSID       "your-ssid"
#define WIFI_PASS       "your-password"

// InfluxDB Cloud Serverless v3 (or v2). Find these in the Influx UI.
//   INFLUX_URL    -> the cluster URL shown after signup, e.g.
//                    https://us-east-1-1.aws.cloud2.influxdata.com
//   INFLUX_BUCKET -> for v3 serverless this is the database name
//   INFLUX_ORG    -> still required by the v2 write API; for serverless any
//                    non-empty value works (or your real org name on v2)
//   INFLUX_TOKEN  -> API token with write access to the bucket/database
#define INFLUX_URL      "https://your-region.aws.cloud2.influxdata.com"
#define INFLUX_BUCKET   "frost"
#define INFLUX_ORG      "your-org"
#define INFLUX_TOKEN    "paste-token-here"
